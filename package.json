{
  "name": "@echo-space/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "lint": "eslint . --cache --fix",
    "format": "prettier . --cache --write",
    "lint:styles": "stylelint \"front/{apps,libs}/**/*.{css,scss}\" --cache --fix --allow-empty-input"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/workspace": "23.2.1",
    "commitizen": "^4.3.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-git": "^1.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "23.2.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
